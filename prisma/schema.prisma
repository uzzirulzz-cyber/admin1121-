generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  salt         String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  token     String    @id
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  producer            String   @default("PlayBeat")
  description         String?
  genre               String?
  bpm                 Int?
  musicalKey          String?
  tags                String?
  coverUrl            String?
  audioUrl            String?
  priceLeaseCents     Int      @default(2999)
  priceExclusiveCents Int      @default(14900)
  published           Boolean  @default(true)
  featured            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerName  String
  customerEmail String
  itemsJson     String
  totalCents    Int
  // pending | paid | fulfilled | refunded | cancelled
  status        String   @default("pending")
  paymentRef    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Asset {
  id          String   @id @default(cuid())
  key         String   @unique
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
