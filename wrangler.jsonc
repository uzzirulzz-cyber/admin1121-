{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playbeat-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PLAYBEAT_KV",
      "id": "bcc870e4a4b24a08b7b110a1c86a7b3e"
    }
  ],
  "services": [
    {
      "binding": "STOREFRONT",
      "service": "playbeat-digital"
    }
  ],
  "vars": {
    "STOREFRONT_URL": "https://playbeat.digital",
    "ADMIN_SUBDOMAINS": "admin.playbeat.digital,manage.playbeat.digital",
    "ADSENSE_ACCOUNT": "accounts/pub-9777611286139666",
    "USD_TO_PKR": "278.5",
    "META_WA_DATASET_ID": "1971402550484565",
    "META_WEB_DATASET_ID": "1971402550484565",
    "ELECTRONIC_FIRST_AFFILIATE_REF": "ywzhmdg",
    "R2_ENDPOINT": "https://334b708ffc14a0b4d48ebfa47634b423.r2.cloudflarestorage.com"
  },
  "routes": [
    { "pattern": "admin.playbeat.digital", "custom_domain": true },
    { "pattern": "manage.playbeat.digital", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
