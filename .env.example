# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Authentication (set in Settings -> Secrets; if unset, first-run setup form appears)
ADMIN_PASSWORD=

# Optional Upstream Cloudflare Worker Base URL (e.g., https://admin.playbeat.digital)
PLAYBEAT_WORKER_URL=

# Google AdSense Management API v2 (OAuth2 or Service Account RS256 fallback; Google rejects API keys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADSENSE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
ADSENSE_ACCOUNT=accounts/pub-9777611286139666

# Meta Conversions API, WhatsApp Event Sharing & OAuth 2.0 (Facebook & Instagram)
META_ACCESS_TOKEN=
META_DATASET_ID=
META_WA_DATASET_ID=
META_WABA_ID=
META_TEST_CODE=
META_APP_ID=
META_APP_SECRET=

# Meta Threads OAuth 2.0
THREADS_APP_ID=
THREADS_APP_SECRET=

# TikTok Events API & TikTok OAuth 2.0
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Electronic First Developer API v1 (https://www.electronicfirst.com/api/dev/v1)
# Generate Api-Key in Electronic First Dashboard -> Settings -> Developer (EF_API_KEY alias also supported)
ELECTRONIC_FIRST_API_KEY=
ELECTRONIC_FIRST_AFFILIATE_REF=ywzhmdg

# Cloudflare R2 S3-Compatible Storage (configure via wrangler secret put)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
